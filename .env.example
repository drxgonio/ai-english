# ---------------------------------------------------------------------------
# SpeakFlow — environment configuration
# Copy this file to `.env.local` and fill in your own key:
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Required. Create one at https://platform.openai.com/api-keys — or use any
# OpenAI-compatible provider (see the provider block at the bottom).
# This key is server-only: it is read inside /api/speak and /api/tts and is
# never exposed to the browser (no NEXT_PUBLIC_ prefix).
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown). Useful for pinning/rolling back models.
# When you use a gateway such as OpenRouter, model names must be prefixed with
# the provider slug (e.g. openai/gpt-4o).
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
# Voice for spoken AI replies. OpenAI voices: alloy | ash | ballad | coral |
# echo | fable | nova | onyx | sage | shimmer | verse. Other TTS providers use
# their own voice names (e.g. Kore for Gemini TTS).
OPENAI_TTS_VOICE=alloy
# Output container: mp3 (default) or pcm. Models differ — Gemini TTS and HeyGen
# Voice only return pcm, MiniMax only mp3. The route retries with the other
# container automatically, so this is only a hint to skip the retry.
# OPENAI_TTS_FORMAT=pcm
# Sample rate used when raw PCM is wrapped into a WAV container (Hz).
# OPENAI_TTS_SAMPLE_RATE=24000

# ---------------------------------------------------------------------------
# OpenAI-compatible providers / gateways
# ---------------------------------------------------------------------------
# Leave OPENAI_BASE_URL unset for https://api.openai.com/v1, or point it at a
# gateway: OpenRouter, LiteLLM, Azure OpenAI, Groq, vLLM, a local mock, …

# --- Example: OpenRouter (chat + speech-to-text + text-to-speech) ----------
# OPENAI_API_KEY=sk-or-v1-your-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=openai/gpt-4o
# OPENAI_TRANSCRIBE_MODEL=openai/whisper-1
# OPENAI_TTS_MODEL=google/gemini-3.8-flash-tts
# OPENAI_TTS_VOICE=Kore
# OPENAI_TTS_FORMAT=pcm
# Optional attribution on OpenRouter leaderboards:
# OPENAI_APP_URL=https://your-app.example
# OPENAI_APP_NAME=SpeakFlow

# ---------------------------------------------------------------------------
# Optional: per-capability overrides (mix providers in one deployment, e.g.
# OpenRouter for the brain and OpenAI for audio). Unset values fall back to
# OPENAI_BASE_URL / OPENAI_API_KEY above.
# ---------------------------------------------------------------------------
# OPENAI_CHAT_BASE_URL=
# OPENAI_CHAT_API_KEY=
# OPENAI_TRANSCRIBE_BASE_URL=
# OPENAI_TRANSCRIBE_API_KEY=
# OPENAI_TTS_BASE_URL=
# OPENAI_TTS_API_KEY=
# Delivery instructions for TTS models that support them (gpt-4o-mini-tts,
# Gemini TTS, Fish Audio). Ignored by other providers.
# OPENAI_TTS_INSTRUCTIONS=Speak in a warm, friendly coaching tone.
